[core]
ignorecase = false
	pager = delta

# Syntax-highlighted, line-numbered diffs via delta (brew "git-delta").
# `navigate = true` lets n/N jump between files in the pager.
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	side-by-side = true
	# Make file paths / line numbers in the diff clickable, opening in VS Code.
	# iTerm2 renders OSC 8 hyperlinks; ⌘-click a path to jump to that line.
	hyperlinks = true
	hyperlinks-file-link-format = "vscode://file/{path}:{line}"
	# Syntax theme (a bat/less theme). Preview alternatives with
	# `delta --show-syntax-themes`; list names with `delta --list-syntax-themes`.
	syntax-theme = Monokai Extended
	# UI chrome colors (independent of syntax-theme): warm taupe instead of the
	# default hard-to-read blue-on-black for file titles, rules, hunk box, and
	# the gutter line numbers.
	file-style = "#b3a58a"
	file-decoration-style = "#4a463c ul"
	hunk-header-decoration-style = "#4a463c box"
	hunk-header-line-number-style = "#8a8069"
	line-numbers-left-style = "#8a8069"
	line-numbers-right-style = "#8a8069"

[merge]
conflictstyle = diff3
	tool = vscode

[push]
autoSetupRemote = true

[pull]
ff = only

[alias]

### Aliases from: http://githowto.com/aliases
    type = cat-file -t
    dump = cat-file -p

### Silvio GIT alias

    # Show the revision log graph using ASCII art
    lg = log --graph --all --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(bold white)— %an%C(reset)%C(bold yellow)%d%C(reset)' --abbrev-commit --date=relative

    # List all local feature branches sorted according to the latest change
    # date to give an overview which branches are under active development.
    stbr = "for-each-ref --sort=-committerdate --format='%1B[32m%(committerdate:iso8601) %1B[34m%(committerdate:relative) %1B[0;m%(refname:short)' refs/heads/"

    # List all local feature branches which have not yet been merged to the
    # master repository (assuming "origin" is the remote for the master repo).
    pending = branch --no-merged origin/master

    # Do a flake8 run on about-to-be-committed files (only works from repo root).
    flake8 = ./bin/flake8  --config etc/flake8.ini `git diff --cached --name-only

### More aliases

    # align local branches to origin
    pruneasorigin = git branch -r | awk '{print $1}' | egrep -v -f /dev/fd/0 <(git branch -vv | grep origin) | awk '{print $1}' | xargs git branch -d

# Machine-specific config (untracked, not version controlled).
# Kept last so its values override the ones above.
# Missing files are silently ignored by git.
[include]
	path = config.untracked
[diff]
	tool = vscode
[difftool "vscode"]
	cmd = code --wait --diff \"$LOCAL\" \"$REMOTE\"
[difftool]
	prompt = false
[mergetool "vscode"]
	cmd = code --wait \"$MERGED\"
